# Local runs: uv run --env-file .env postpilot <command>
# Production: GitHub Secrets / Variables with the same names.

# --- Supabase (when set, replaces the Google Sheet) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=            # server-side only: never put it in web/

# --- Google Sheets (legacy) ---
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service_account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=      # full JSON; used in GitHub Actions instead of the file

# --- Meta ---
META_GRAPH_VERSION=                 # pin from your app dashboard, e.g. v23.0
META_TOKEN_MAIN=                    # one per account; the name goes in Accounts.token_env

# --- Telegram assist (fb_profile, tiktok, youtube rows) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEB_APP_URL=                        # e.g. https://postpilot.pages.dev: Telegram links to the handoff page

# --- Behavior ---
PP_LATE_GRACE_MINUTES=180
PP_MAX_POSTS_PER_RUN=10
PP_MAX_ATTEMPTS=3
PP_STALE_POSTING_MINUTES=30
PP_NUDGE_HOUR=16                    # Telegram 'nothing posted today' reminder, local hour; off to disable
